# PostgreSQL connection string
# The +psycopg suffix is required because the project installs psycopg 3
# (psycopg[binary]); SQLAlchemy resolves a plain postgresql:// URL to the
# psycopg 2 dialect, which is not installed.
DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>

# Comma-separated list of origins allowed by CORS.
# Leave unset to allow only http://localhost:5173 (the local dev frontend).
# Example for production:
# CORS_ORIGINS=https://your-vercel-app.vercel.app